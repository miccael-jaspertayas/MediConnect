<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MediConnect.Mobile.Models"
    xmlns:vm="clr-namespace:MediConnect.Mobile.ViewModels"
    x:Class="MediConnect.Mobile.Views.VitalsPage"
    x:DataType="vm:VitalsViewModel"
    Title="Vitals"
    BackgroundColor="#F4F6FA">

    <Grid>

        <VerticalStackLayout
            Padding="20,15"
            Spacing="14">

            <Label
                Text="Vitals History"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#1C6F6F"/>

            <CollectionView ItemsSource="{Binding Vitals}">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="40"
                        HorizontalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="❤️"
                            FontSize="40"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="No vitals recorded yet"
                            FontAttributes="Bold"
                            TextColor="#7A8699"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Tap the + button to add your first entry."
                            FontSize="12"
                            TextColor="#A6AFBD"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:VitalsModel">
                        <Border Padding="16" BackgroundColor="White" StrokeShape="RoundRectangle 16" Stroke="Transparent">
                            <Border.Shadow>
                                <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="VitalCard_Tapped" CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" WidthRequest="34">
                                    <Label Text="{Binding RecordedAt, StringFormat='{0:%d}'}" 
                           FontSize="20" FontAttributes="Bold" TextColor="#1C6F6F" HorizontalOptions="Center"/>
                                    <Label Text="{Binding RecordedAt, StringFormat='{0:MMM}'}" 
                           FontSize="11" TextColor="#7FADAB" HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="#E4E9F0"/>

                                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding SystolicBP, StringFormat='BP: {0}/{1} mmHg', TargetNullValue='BP: N/A'}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="BP: " FontAttributes="Bold" TextColor="#1E2A38"/>
                                                <Span Text="{Binding SystolicBP}" TextColor="#1E2A38"/>
                                                <Span Text="/"/>
                                                <Span Text="{Binding DiastolicBP}" TextColor="#1E2A38"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding HeartRate, StringFormat='HR: {0} bpm'}" FontSize="13" TextColor="#7A8699"/>
                                    <Label Text="{Binding Temperature, StringFormat='Temp: {0}°C'}" FontSize="13" TextColor="#7A8699"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="3" Text="›" FontSize="22" TextColor="#B7C0CC" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

        <Button
            Text="+"
            FontSize="26"
            FontAttributes="Bold"
            TextColor="White"
            BackgroundColor="#1C6F6F"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="20"
            Clicked="AddVitalsFab_Clicked">

            <Button.Shadow>
                <Shadow
                    Brush="#1C6F6F"
                    Radius="10"
                    Opacity="0.4"
                    Offset="0,4"/>
            </Button.Shadow>

        </Button>

    </Grid>

</ContentPage>