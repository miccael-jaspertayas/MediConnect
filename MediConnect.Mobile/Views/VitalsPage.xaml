<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MediConnect.Mobile.Models"
    xmlns:vm="clr-namespace:MediConnect.Mobile.ViewModels"
    x:Class="MediConnect.Mobile.Views.VitalsPage"
    x:DataType="vm:VitalsViewModel"
    Title=""
    BackgroundColor="#F4F6FA">

    <Grid>

        <VerticalStackLayout
            Padding="20,15"
            Spacing="14">

            <Label
                Text="Vitals History"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#1C6F6F"/>


            <Border BackgroundColor="{Binding AnalysisBadgeColor}" 
        StrokeShape="RoundRectangle 12" 
        Stroke="Transparent" 
        Padding="14">
                <Border.Shadow>
                    <Shadow Brush="#1E2A38" Opacity="0.04" Radius="6" Offset="0,2"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Health Insight Summary" 
               FontAttributes="Bold" 
               FontSize="13" 
               TextColor="{Binding AnalysisTextColor}"/>
                    <Label Text="{Binding VitalsAnalysis}" 
               FontSize="12" 
               TextColor="{Binding AnalysisTextColor}"/>
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Vitals}">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="40"
                        HorizontalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="❤️"
                            FontSize="40"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="No vitals recorded yet"
                            FontAttributes="Bold"
                            TextColor="#7A8699"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Tap the + button to add your first entry."
                            FontSize="12"
                            TextColor="#A6AFBD"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Vitals">
                        <Border Padding="16" BackgroundColor="White" StrokeShape="RoundRectangle 16" Stroke="Transparent">
                            <Border.Shadow>
                                <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="VitalCard_Tapped" CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="12">

                                <!-- Date header row -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding RecordedAt, StringFormat='{0:MMM d, yyyy}'}"
                               FontSize="14" FontAttributes="Bold" TextColor="#1E2A38"/>
                                        <Label Text="{Binding RecordedAt, StringFormat='{0:h:mm tt}'}"
                               FontSize="11" TextColor="#A6AFBD"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#B7C0CC" VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#E4E9F0"/>

                                <!-- Vitals grid: 2x2 stat chips -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                                    <!-- Blood Pressure -->
                                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Blood Pressure" FontSize="10" TextColor="#7A8699"/>
                                            <Label FontSize="16" FontAttributes="Bold" TextColor="#1E2A38">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding SystolicBP}"/>
                                                        <Span Text="/"/>
                                                        <Span Text="{Binding DiastolicBP}"/>
                                                        <Span Text=" mmHg" FontSize="11" FontAttributes="None" TextColor="#7A8699"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Heart Rate -->
                                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Heart Rate" FontSize="10" TextColor="#7A8699"/>
                                            <Label FontSize="16" FontAttributes="Bold" TextColor="#1E2A38">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding HeartRate}"/>
                                                        <Span Text=" bpm" FontSize="11" FontAttributes="None" TextColor="#7A8699"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Temperature -->
                                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Temperature" FontSize="10" TextColor="#7A8699"/>
                                            <Label FontSize="16" FontAttributes="Bold" TextColor="#1E2A38">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Temperature}"/>
                                                        <Span Text="°C" FontSize="11" FontAttributes="None" TextColor="#7A8699"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- SpO2 -->
                                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Blood Oxygen" FontSize="10" TextColor="#7A8699"/>
                                            <Label FontSize="16" FontAttributes="Bold" TextColor="#1E2A38">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding SpO2}"/>
                                                        <Span Text="%" FontSize="11" FontAttributes="None" TextColor="#7A8699"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>

                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

        <Button
            Text="+"
            FontSize="26"
            FontAttributes="Bold"
            TextColor="White"
            BackgroundColor="#1C6F6F"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="20"
            Clicked="AddVitalsFab_Clicked">

            <Button.Shadow>
                <Shadow
                    Brush="#1C6F6F"
                    Radius="10"
                    Opacity="0.4"
                    Offset="0,4"/>
            </Button.Shadow>

        </Button>

    </Grid>

</ContentPage>