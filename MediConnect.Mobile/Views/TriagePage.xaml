<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MediConnect.Mobile.Converters"
             x:Class="MediConnect.Mobile.Views.TriagePage"
             Title=""
             BackgroundColor="#F5F7F8">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:SymptomsListConverter x:Key="SymptomsListConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Symptom Triage"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#1F7A70" />

            <Label Text="Search and select what you're feeling. We'll suggest where to go."
                   FontSize="14"
                   TextColor="#6B7280" />

            <!-- Search box -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#E2E8ED"
                    BackgroundColor="White"
                    Padding="12,8">
                <Entry Placeholder="Type a symptom..."
                       Text="{Binding SearchText}"
                       PlaceholderColor="#9CA3AF"
                       TextColor="Black"
                       BackgroundColor="Transparent" />
            </Border>

            <!-- Suggestions -->
            <CollectionView ItemsSource="{Binding Suggestions}"
                             HeightRequest="160">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#E2E8ED"
                                BackgroundColor="White"
                                Padding="12,10"
                                Margin="0,3">
                            <Label Text="{Binding .}" TextColor="#111827">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectSymptomCommand}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Selected symptoms -->
            <Label Text="Selected Symptoms" FontAttributes="Bold" TextColor="#111827" FontSize="16" />

            <CollectionView ItemsSource="{Binding SelectedSymptoms}"
                             HeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="#E6F4F2"
                                Padding="14,8"
                                Margin="0,3">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding .}" TextColor="#1F7A70" VerticalOptions="Center" />
                                <Label Text="✕" TextColor="#1F7A70" FontAttributes="Bold" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSymptomCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Check / Update button -->
            <Border StrokeShape="RoundRectangle 24"
                    BackgroundColor="#1F7A70"
                    Padding="0,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CheckSymptomsCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding CheckButtonText}"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </Border>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                IsVisible="{Binding IsLoading}"
                                Color="#1F7A70" />

            <!-- Result -->
            <Border BackgroundColor="{Binding ResultColor}"
            Padding="16"
            StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding ResultTier}" FontAttributes="Bold" TextColor="White" FontSize="18" />
                    <Label Text="{Binding ResultExplanation}" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Cancel Edit"
               TextColor="#DC2626"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               IsVisible="{Binding IsEditing}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- History section -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <Label Grid.Column="0" Text="Recent Check-ins" FontAttributes="Bold" TextColor="#111827" FontSize="16" />
                <Label Grid.Column="1" Text="Clear All" TextColor="#DC2626" FontSize="13">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearAllCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <CollectionView ItemsSource="{Binding History}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12"
                            Stroke="#E2E8ED"
                            BackgroundColor="White"
                            Padding="14"
                            Margin="0,4">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy - hh:mm tt}'}"
                                   FontSize="12" TextColor="#6B7280" />
                                <Label Text="{Binding Tier}" FontAttributes="Bold" TextColor="#1F7A70" />
                                <Label Text="{Binding Symptoms, Converter={StaticResource SymptomsListConverter}}"
                                TextColor="#111827" FontSize="13" />
                                <Label Text="{Binding Explanation}" TextColor="#111827" FontSize="13" />

                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16" Margin="0,6,0,0">
                                    <Label Grid.Column="0" Text="Edit" TextColor="#1F7A70" FontAttributes="Bold" FontSize="13">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditLogCommand}"
                                            CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Grid.Column="1" Text="Delete" TextColor="#DC2626" FontAttributes="Bold" FontSize="13">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteLogCommand}"
                                            CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Load More"
            Command="{Binding LoadMoreHistoryCommand}"
            BackgroundColor="Transparent"
            TextColor="#1F7A70" />

            <ActivityIndicator IsRunning="{Binding IsHistoryLoading}"
                    IsVisible="{Binding IsHistoryLoading}"
                    Color="#1F7A70" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>