<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediConnect.Mobile.Views.TriagePage"
             Title="Symptom Triage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Entry x:Name="SymptomSearchEntry"
                   Placeholder="Type a symptom..." />

            <CollectionView x:Name="SuggestionsList"
                             HeightRequest="150" />

            <Label Text="Selected Symptoms:" FontAttributes="Bold" />
            <CollectionView x:Name="SelectedSymptomsList"
                             HeightRequest="120" />

            <Button x:Name="CheckSymptomsButton"
                    Text="Check Symptoms" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>