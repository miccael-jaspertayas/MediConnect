<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MediConnect.Mobile.Views.RecordsPage"
    Title="Medical Records">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="Medical Records"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <DatePicker
                Date="{Binding VisitDate}" />

            <Entry
                Placeholder="Hospital / Clinic"
                Text="{Binding HospitalName}" />

            <Entry
                Placeholder="Doctor"
                Text="{Binding DoctorName}" />

            <Entry
                Placeholder="Diagnosis"
                Text="{Binding Diagnosis}" />

            <Editor
                Placeholder="Notes"
                HeightRequest="120"
                Text="{Binding Notes}" />

            <Button
                Text="Add Record"
                Command="{Binding AddRecordCommand}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Label
                Text="Medical History"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,20,0,0"/>

            <CollectionView
                ItemsSource="{Binding Records}">

                <CollectionView.EmptyView>

                    <Label
                        Text="No medical records found."
                        HorizontalOptions="Center"
                        TextColor="Gray"/>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame
                            Margin="0,5"
                            Padding="10"
                            BorderColor="LightGray">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding HospitalName}"
                                    FontSize="18"
                                    FontAttributes="Bold"/>

                                <Label
                                    Text="{Binding DoctorName}" />

                                <Label
                                    Text="{Binding Diagnosis}" />

                                <Label
                                    Text="{Binding VisitDate, StringFormat='Visit Date: {0:MMMM dd, yyyy}'}"
                                    FontSize="12"
                                    TextColor="Gray"/>

                                <Label
                                    Text="{Binding Notes}" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>