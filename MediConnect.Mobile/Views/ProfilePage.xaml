<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MediConnect.Mobile.ViewModels"
             x:Class="MediConnect.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="My Profile">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Name" FontAttributes="Bold" />
            <Entry Text="{Binding Name}" Placeholder="Full name" />

            <Label Text="Date of Birth" FontAttributes="Bold" />
            <DatePicker Date="{Binding Dob}" />

            <Label Text="Blood Type" FontAttributes="Bold" />
            <Entry Text="{Binding BloodType}" Placeholder="e.g. O+" />

            <Label Text="Allergies" FontAttributes="Bold" />
            <Editor Text="{Binding Allergies}" AutoSize="TextChanges" />

            <Label Text="Medications" FontAttributes="Bold" />
            <Editor Text="{Binding Medications}" AutoSize="TextChanges" />
            
            <!-- "Look up medication" OpenFDA button goes here -->
            <Label Text="{Binding MedicationLookupResult}" FontAttributes="Italic" />

            <Label Text="Emergency Contact Name" FontAttributes="Bold" />
            <Entry Text="{Binding EmergencyContactName}" />

            <Label Text="Emergency Contact Phone" FontAttributes="Bold" />
            <Entry Text="{Binding EmergencyContactPhone}" Keyboard="Telephone" />

            <Label Text="{Binding StatusMessage}" TextColor="DarkRed" />

            <Button Text="Save" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>