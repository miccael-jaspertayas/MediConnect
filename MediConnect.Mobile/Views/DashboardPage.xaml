<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MediConnect.Mobile.ViewModels"
             x:Class="MediConnect.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding Greeting}" FontSize="22" FontAttributes="Bold" />

            <Border Stroke="LightGray" StrokeShape="RoundRectangle 10" Padding="15">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Latest Vitals" FontAttributes="Bold" />
                    <Label Text="{Binding LatestVitalsSummary}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="View Vitals" Command="{Binding GoToVitalsCommand}" />
            <Button Text="View Records" Command="{Binding GoToRecordsCommand}" />
            <Button Text="Symptom Triage" Command="{Binding GoToTriageCommand}" />
            <Button Text="My Profile" Command="{Binding GoToProfileCommand}" />

            <Button Text="Log Out" Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent" TextColor="Red" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>