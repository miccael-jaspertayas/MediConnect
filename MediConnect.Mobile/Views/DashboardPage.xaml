<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
    xmlns:dtos="clr-namespace:MediConnect.Mobile.Dtos"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MediConnect.Mobile.ViewModels"
    x:Class="MediConnect.Mobile.Views.DashboardPage"
    x:DataType="vm:DashboardViewModel"
    Title=""
    BackgroundColor="#F4F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="20,15" Spacing="18">

            <!-- Greeting -->
            <Label
                Text="{Binding Greeting}"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#1C6F6F"
                HorizontalOptions="Center"/>

            <!-- Latest Vitals Card -->
            <Border
                Padding="18"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 16"
                Stroke="Transparent">
                <Border.Shadow>
                    <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Latest Vitals" FontSize="15" FontAttributes="Bold" TextColor="#1E2A38"/>
                        <Label Grid.Column="1" Text="{Binding LatestVitalsDate}" FontSize="11" TextColor="#A6AFBD"
                   IsVisible="{Binding HasVitals}" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Empty state -->
                    <VerticalStackLayout IsVisible="{Binding HasVitals, Converter={StaticResource InvertedBoolConverter}}"
                              Spacing="6" HorizontalOptions="Center" Margin="0,10">
                        <Label Text="🩺" FontSize="26" HorizontalOptions="Center"/>
                        <Label Text="No vitals recorded yet." FontSize="13" TextColor="#7A8699" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Stat chips -->
                    <Grid IsVisible="{Binding HasVitals}"
              ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Blood Pressure" FontSize="10" TextColor="#7A8699"/>
                                <Label FontSize="16" FontAttributes="Bold" TextColor="#1E2A38">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding LatestVitals.SystolicBP}"/>
                                            <Span Text="/"/>
                                            <Span Text="{Binding LatestVitals.DiastolicBP}"/>
                                            <Span Text=" mmHg" FontSize="11" TextColor="#7A8699"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Heart Rate" FontSize="10" TextColor="#7A8699"/>
                                <Label FontSize="16" FontAttributes="Bold" TextColor="#1E2A38">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding LatestVitals.HeartRate}"/>
                                            <Span Text=" bpm" FontSize="11" TextColor="#7A8699"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Temperature" FontSize="10" TextColor="#7A8699"/>
                                <Label FontSize="16" FontAttributes="Bold" TextColor="#1E2A38">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding LatestVitals.Temperature}"/>
                                            <Span Text="°C" FontSize="11" TextColor="#7A8699"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Blood Oxygen" FontSize="10" TextColor="#7A8699"/>
                                <Label FontSize="16" FontAttributes="Bold" TextColor="#1E2A38">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding LatestVitals.SpO2}"/>
                                            <Span Text="%" FontSize="11" TextColor="#7A8699"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <Button
                        Text="Log New Vitals"
                        Command="{Binding GoToVitalsCommand}"
                        BackgroundColor="#E3F1F0"
                        TextColor="#1C6F6F"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="14"
                        HeightRequest="40"/>

                </VerticalStackLayout>
            </Border>

            <!-- Vitals Trends Card -->
            <Border
                Padding="18"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 16"
                Stroke="Transparent"
                IsVisible="{Binding HasVitals}">
                <Border.Shadow>
                    <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">

                    <Label Text="Vitals Trends" FontSize="15" FontAttributes="Bold" TextColor="#1E2A38"/>

                    <!-- Range toggle -->
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Last 10" FontSize="11" Padding="12,6" CornerRadius="12"
                                BackgroundColor="{Binding SelectedRange, Converter={StaticResource RangeToColorConverter}, ConverterParameter=0}"
                                TextColor="{Binding SelectedRange, Converter={StaticResource RangeToTextColorConverter}, ConverterParameter=0}"
                                Command="{Binding SetRangeCommand}" CommandParameter="0"/>
                        <Button Text="1 Week" FontSize="11" Padding="12,6" CornerRadius="12"
                                BackgroundColor="{Binding SelectedRange, Converter={StaticResource RangeToColorConverter}, ConverterParameter=1}"
                                TextColor="{Binding SelectedRange, Converter={StaticResource RangeToTextColorConverter}, ConverterParameter=1}"
                                Command="{Binding SetRangeCommand}" CommandParameter="1"/>
                        <Button Text="All Time" FontSize="11" Padding="12,6" CornerRadius="12"
                                BackgroundColor="{Binding SelectedRange, Converter={StaticResource RangeToColorConverter}, ConverterParameter=2}"
                                TextColor="{Binding SelectedRange, Converter={StaticResource RangeToTextColorConverter}, ConverterParameter=2}"
                                Command="{Binding SetRangeCommand}" CommandParameter="2"/>
                    </HorizontalStackLayout>

                    <!-- Blood Pressure -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Blood Pressure (mmHg)" FontSize="11" TextColor="#7A8699"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="Sys" FontSize="10" TextColor="#1C6F6F" VerticalOptions="Center" WidthRequest="30"/>
                            <charts:ChartView Grid.Column="1" HeightRequest="150" Chart="{Binding BpSystolicChart}"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="Dia" FontSize="10" TextColor="#6FA8A3" VerticalOptions="Center" WidthRequest="30"/>
                            <charts:ChartView Grid.Column="1" HeightRequest="150" Chart="{Binding BpDiastolicChart}"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Heart Rate -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Heart Rate (bpm)" FontSize="11" TextColor="#7A8699"/>
                        <charts:ChartView HeightRequest="150" Chart="{Binding HeartRateChart}"/>
                    </VerticalStackLayout>

                    <!-- Temperature -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Temperature (°C)" FontSize="11" TextColor="#7A8699"/>
                        <charts:ChartView HeightRequest="150" Chart="{Binding TemperatureChart}"/>
                    </VerticalStackLayout>

                    <!-- SpO2 -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Blood Oxygen — SpO2 (%)" FontSize="11" TextColor="#7A8699"/>
                        <charts:ChartView HeightRequest="150" Chart="{Binding SpO2Chart}"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Recent Symptom Check-ins -->
            <Border
                Padding="18"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 16"
                Stroke="Transparent"
                IsVisible="{Binding HasCheckIns}">
                <Border.Shadow>
                    <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Recent Symptom Check-ins" FontSize="15" FontAttributes="Bold" TextColor="#1E2A38"/>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentCheckIns}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type dtos:TriageLogResponse}">
                                <Border BackgroundColor="#F4F6FA" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="12">
                                    <VerticalStackLayout Spacing="6">

                                        <Label Text="{Binding CreatedAt, Converter={StaticResource UtcToLocalTimeConverter}}" FontSize="11" TextColor="#A6AFBD"/>

                                        <FlexLayout BindableLayout.ItemsSource="{Binding Symptoms}"
                                                    Wrap="Wrap"
                                                    Direction="Row"
                                                    JustifyContent="Start"
                                                    AlignItems="Start">         
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border BackgroundColor="#E3F1F0"
                                                            StrokeShape="RoundRectangle 12"
                                                            Stroke="Transparent"
                                                            Padding="10,4"
                                                            Margin="0,0,6,6">
                                                        <Label Text="{Binding .}" FontSize="11" TextColor="#1C6F6F" FontAttributes="Bold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button
                        Text="View Full History"
                        Command="{Binding GoToTriageCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#1C6F6F"
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </Border>

            <!-- Quick Actions -->
            <Label
                Text="Quick Actions"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="#7A8699"
                Margin="4,10,0,0"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                <Border Grid.Row="0" Grid.Column="0"
                        Padding="16"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToVitalsCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="🩸" FontSize="24" HorizontalOptions="Center"/>
                        <Label Text="Vitals" FontSize="13" FontAttributes="Bold" TextColor="#1E2A38" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        Padding="16"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRecordsCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="📋" FontSize="24" HorizontalOptions="Center"/>
                        <Label Text="Records" FontSize="13" FontAttributes="Bold" TextColor="#1E2A38" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Padding="16"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToTriageCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="🩺" FontSize="24" HorizontalOptions="Center"/>
                        <Label Text="Triage" FontSize="13" FontAttributes="Bold" TextColor="#1E2A38" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        Padding="16"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="#1E2A38" Opacity="0.06" Radius="8" Offset="0,2"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="👤" FontSize="24" HorizontalOptions="Center"/>
                        <Label Text="Profile" FontSize="13" FontAttributes="Bold" TextColor="#1E2A38" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Log Out -->
            <Button
                Style="{StaticResource DangerButtonStyle}"
                Text="Log Out"
                Command="{Binding LogoutCommand}"
                Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>