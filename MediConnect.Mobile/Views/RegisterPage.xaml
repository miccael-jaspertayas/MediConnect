<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MediConnect.Mobile.ViewModels"
             x:Class="MediConnect.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Register">
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label Text="Create Account" FontSize="24" HorizontalOptions="Center" />
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
        <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" />
        <Label Text="{Binding StatusMessage}" />
        <Button Text="Register" Command="{Binding RegisterCommand}" />
    </VerticalStackLayout>
</ContentPage>

