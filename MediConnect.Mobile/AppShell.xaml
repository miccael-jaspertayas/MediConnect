<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:views="clr-namespace:MediConnect.Mobile.Views"
      x:Class="MediConnect.Mobile.AppShell"
      Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="Login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="Register" ContentTemplate="{DataTemplate views:RegisterPage}" />
    
    <TabBar>
        <ShellContent Route="Dashboard" Title="Home" Icon="dashboard.svg"
                      ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Route="Vitals" Title="Vitals" Icon="vitals.svg"
                      ContentTemplate="{DataTemplate views:VitalsPage}" />
        <ShellContent Route="Records" Title="Records" Icon="records.svg"
                      ContentTemplate="{DataTemplate views:RecordsPage}" />
        <ShellContent Route="Triage" Title="Triage" Icon="triage.svg"
                      ContentTemplate="{DataTemplate views:TriagePage}" />
    </TabBar>

</Shell>


